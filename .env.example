# Configuração do IMBONDEIRO OS em produção.
# Copie para .env e substitua TODOS os valores. O .env não vai para o repositório.

# =============================================================================
# BASE DE DADOS  (obrigatório)
# =============================================================================
DATABASE_NAME=imbondeiro
DATABASE_USER=imbondeiro
# Gere: openssl rand -base64 24
DATABASE_PASSWORD=

# =============================================================================
# SEGREDOS DE SESSÃO  (obrigatório)
# =============================================================================
# TÊM de ser diferentes um do outro e ter pelo menos 32 caracteres.
# A aplicação recusa arrancar em produção se ficarem por preencher.
# Gere cada um com: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# =============================================================================
# ADMINISTRADOR DA PLATAFORMA  (obrigatório)
# =============================================================================
# A sua conta — quem vende o sistema e cria as empresas no ecrã «Plataforma».
# É criada no primeiro arranque; a palavra-passe só conta nesse momento
# (depois muda-a no Perfil). Em produção o registo livre está fechado:
# ninguém cria empresas pelo ecrã de entrada. REGISTRATION_OPEN=true reabre-o.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrador da plataforma

# =============================================================================
# ENDEREÇOS  (obrigatório)
# =============================================================================
# O endereço por onde as pessoas abrem o sistema. A aplicação web serve a API
# pelo mesmo endereço (/api), por isso é também a única origem autorizada.
APP_WEB_URL=https://frota.suaempresa.ao
# Porta local da aplicação web (o proxy com TLS aponta para aqui).
WEB_PORT=80

# =============================================================================
# CÓPIAS DE SEGURANÇA  (automáticas; ficam em ./backups)
# =============================================================================
# Hora do dia (00–23) a que se faz a cópia da base de dados e dos ficheiros.
BACKUP_HOUR=02
# Quantos dias de cópias guardar antes de apagar as mais antigas.
BACKUP_KEEP_DAYS=30
# Para fora do servidor: nome do remoto em deploy/easypanel/rclone.conf + pasta (ex.: copias:imbondeiro).
# Vazio = as cópias ficam só no servidor.
BACKUP_REMOTE=

# =============================================================================
# EMAIL  (opcional — sem isto os avisos ficam só dentro da aplicação)
# =============================================================================
# Enquanto MAIL_HOST estiver vazio, o sistema NÃO envia emails e marca cada
# aviso como "modo demonstração". Nunca diz que enviou o que não enviou.
#
# Depois de preencher, teste em Definições → Envio de email → "Enviar email de
# teste", ou por API:
#   curl -X POST http://localhost:8080/api/v1/email/test -H "Authorization: Bearer <token>"
#
# Exemplos de configuração:
#
#   Gmail / Google Workspace
#     MAIL_HOST=smtp.gmail.com
#     MAIL_PORT=587
#     MAIL_USERNAME=avisos@suaempresa.ao
#     MAIL_PASSWORD=<palavra-passe de APLICAÇÃO, não a da conta>
#     MAIL_STARTTLS=true
#     (crie a palavra-passe de aplicação em myaccount.google.com/apppasswords —
#      exige verificação em duas etapas activa)
#
#   Microsoft 365 / Outlook
#     MAIL_HOST=smtp.office365.com
#     MAIL_PORT=587
#     MAIL_STARTTLS=true
#
#   Servidor próprio com SSL directo
#     MAIL_PORT=465
#     MAIL_STARTTLS=false
#
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_AUTH=true
MAIL_STARTTLS=true
# Endereço que aparece como remetente. Muitos servidores exigem que seja igual
# a MAIL_USERNAME, senão recusam a mensagem.
MAIL_FROM=
MAIL_FROM_NAME=IMBONDEIRO OS

# =============================================================================
# TRACCAR DA PLATAFORMA  (recomendado para vender o sistema)
# =============================================================================
# O Traccar de quem vende o sistema, com credenciais de ADMINISTRADOR. Serve
# para o ecrã «Plataforma» criar, por cada empresa cliente, uma conta própria
# no Traccar e guardar-lhe o token nas Configurações dela. A partir daí os
# rastreadores que a empresa registar no IMBONDEIRO OS passam a existir no
# Traccar sozinhos, na conta dela. Cada empresa só vê os seus aparelhos.
# Estas credenciais nunca são usadas para posições nem para comandos.
#
TRACCAR_URL=https://traccar.o-seu-dominio
TRACCAR_USER=
TRACCAR_PASSWORD=

# =============================================================================
# MOTOR DE ROTAS DA PLATAFORMA  (recomendado)
# =============================================================================
# Um OSRM com o mapa de Angola (ver docs/EASYPANEL.md, secção 9). Todas as
# empresas o usam sem configurar nada; uma empresa pode indicar o seu próprio
# em Configurações → Motor de rotas.
ROUTING_URL=

# =============================================================================
# AJUSTES  (opcional — os valores por omissão servem)
# =============================================================================
# RATE_LIMIT_ENABLED=true
# SCHEDULER_ENABLED=true
# STORAGE_PATH=/var/lib/autocare/files
# DB_POOL_MAX=10
# LOG_LEVEL=INFO
